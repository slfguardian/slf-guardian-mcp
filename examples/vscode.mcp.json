{
  "inputs": [
    {
      "type": "promptString",
      "id": "slf-api-key",
      "description": "SLF Guardian API key",
      "password": true
    }
  ],
  "servers": {
    "slf-guardian": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "slf-guardian-mcp==1.2.2",
        "slf-guardian-mcp"
      ],
      "env": {
        "SLF_API_KEY": "${input:slf-api-key}"
      }
    }
  }
}
